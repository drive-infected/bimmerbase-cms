{
  "kind": "collectionType",
  "collectionName": "engine_families",
  "info": {
    "singularName": "engine-family",
    "pluralName": "engine-families",
    "displayName": "Engine Family"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "required": true,
      "unique": true
    },
    "subtitle": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slug": {
      "type": "uid"
    },
    "aspiration": {
      "type": "enumeration",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "enum": [
        "naturally_aspirated",
        "turbocharged",
        "supercharged"
      ]
    },
    "fuel_type": {
      "type": "enumeration",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "enum": [
        "Petrol",
        "Diesel"
      ]
    },
    "layout": {
      "type": "enumeration",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "enum": [
        "longitudinal",
        "transverse"
      ]
    },
    "configuration": {
      "type": "enumeration",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "enum": [
        "inline",
        "v",
        "flat"
      ]
    },
    "v_angle_deg": {
      "type": "integer",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "cylinder_conunt": {
      "type": "integer",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "valves_per_cylinder": {
      "type": "integer",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "valvetrain": {
      "type": "enumeration",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "enum": [
        "SOHC",
        "DOHC"
      ]
    },
    "timing_system": {
      "type": "enumeration",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "enum": [
        "chain",
        "belt",
        "gear",
        "camless"
      ]
    },
    "head_material": {
      "type": "enumeration",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "enum": [
        "Cast iron",
        "Aluminium"
      ]
    },
    "block_material": {
      "type": "enumeration",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "enum": [
        "Cast iron",
        "Aluminium"
      ]
    },
    "production_start": {
      "type": "date",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "production_end": {
      "type": "date",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "successor": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::engine-family.engine-family",
      "inversedBy": "predecessor"
    },
    "predecessor": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::engine-family.engine-family",
      "mappedBy": "successor"
    },
    "engines": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::engine.engine",
      "mappedBy": "engine_family"
    },
    "description": {
      "type": "blocks",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "technical_update": {
      "type": "blocks",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "features": {
      "type": "blocks",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "articles": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::article.article",
      "mappedBy": "engine_families"
    },
    "image": {
      "type": "media",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    }
  }
}
