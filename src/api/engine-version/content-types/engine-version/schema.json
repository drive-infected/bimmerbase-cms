{
  "kind": "collectionType",
  "collectionName": "engine_versions",
  "info": {
    "singularName": "engine-version",
    "pluralName": "engine-versions",
    "displayName": "Engine Version"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "code": {
      "type": "uid",
      "required": true
    },
    "title": {
      "type": "string"
    },
    "engine": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::engine.engine",
      "inversedBy": "engine_versions"
    },
    "power_hp": {
      "type": "integer"
    },
    "power_kw": {
      "type": "integer"
    },
    "power_rpm": {
      "type": "integer"
    },
    "torque_nm": {
      "type": "integer"
    },
    "torque_rpm": {
      "type": "integer"
    },
    "compression_ratio": {
      "type": "decimal"
    },
    "ecu_code": {
      "type": "string"
    },
    "catalyst": {
      "type": "boolean"
    },
    "dpf": {
      "type": "boolean"
    },
    "emissions_standard": {
      "type": "enumeration",
      "enum": [
        "Euro 1",
        "Euro 2",
        "Euro 3",
        "Euro 4",
        "Euro 5",
        "Euro 6",
        "Euro 7"
      ]
    },
    "fuel_grade": {
      "type": "string"
    },
    "market": {
      "type": "enumeration",
      "enum": [
        "Europe",
        "USA",
        "Egypt",
        "Indonesia",
        "Malaysia",
        "Mexico",
        "Philippines",
        "Russia",
        "Thailand",
        "Vietnam"
      ]
    },
    "production_start": {
      "type": "date"
    },
    "production_end": {
      "type": "date"
    },
    "model_codes": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::model-code.model-code",
      "inversedBy": "engine_versions"
    },
    "additional_info": {
      "type": "text"
    }
  }
}
