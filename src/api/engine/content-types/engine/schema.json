{
  "kind": "collectionType",
  "collectionName": "engines",
  "info": {
    "singularName": "engine",
    "pluralName": "engines",
    "displayName": "Engine"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "engine_family": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::engine-family.engine-family",
      "inversedBy": "engines"
    },
    "slug": {
      "type": "uid"
    },
    "displacement_cc": {
      "type": "integer"
    },
    "bore_mm": {
      "type": "decimal"
    },
    "stroke_mm": {
      "type": "decimal"
    },
    "firing_order": {
      "type": "string"
    },
    "engine_mass_kg": {
      "type": "decimal"
    },
    "oil_type": {
      "type": "string"
    },
    "oil_capacity": {
      "type": "decimal"
    },
    "coolant_type": {
      "type": "string"
    },
    "coolant_capacity": {
      "type": "decimal"
    },
    "articles": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::article.article",
      "mappedBy": "engines"
    },
    "user_cars": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::user-car.user-car",
      "mappedBy": "engine"
    },
    "engine_versions": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::engine-version.engine-version",
      "mappedBy": "engine"
    },
    "production_start": {
      "type": "date"
    },
    "production_end": {
      "type": "date"
    }
  }
}
